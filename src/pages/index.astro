---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { Image } from "astro:assets";
import mikiPhoto from "@/assets/images/miki2.png";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Blog
      </h1>
      
      <div class="flex items-center gap-4">
        <div class="w-24 h-24 sm:w-32 sm:h-32 flex-shrink-0 overflow-hidden rounded-full border-2 border-orange-500 shadow-md">
          <Image src={mikiPhoto} alt="Mikołaj Liszewski" class="w-full h-full object-cover" />
        </div>
        <div>
          <h1 class="text-3xl font-bold sm:text-5xl">
            Mikołaj Liszewski <span class="blink">█</span>
          </h1>
        </div>
      </div>

      <h2 class="mt-2 text-xl font-medium text-orange-500 sm:text-2xl">
        Pasjonat IT & Akwarystyki
      </h2>
      
      <p class="mt-4">
        Cześć mam na imię Mikołaj jestem studentem i na tym blogu chciałbym pokazywać moje projekty związane z IT.
        Poza IT intersuję się akwarystyką i lubie czasem pograć w gry głównie survivale (ark,icarus,minecraft,terraria,7 days to die,rust)
      </p>

      
      
      <div class="mt-10 border-t border-border pt-8">
        <div class="mb-8">
          <p class="font-mono text-orange-500 mb-3">$ ls skills/</p>
          <div class="flex flex-wrap gap-3">
            <span class="border border-orange-500/30 bg-orange-500/5 px-3 py-1 text-xs font-mono tracking-tighter">html_css.exe</span>
            <span class="border border-orange-500/30 bg-orange-500/5 px-3 py-1 text-xs font-mono tracking-tighter">astro_framework.sh</span>
            <span class="border border-orange-500/30 bg-orange-500/5 px-3 py-1 text-xs font-mono tracking-tighter">git_github.git</span>
          </div>
        </div>

        <div class="space-y-6">
          <p class="font-mono text-orange-500 mb-1">$ system --status</p>
          <div>
            <div class="flex justify-between text-[15px] uppercase tracking-widest mb-1 text-gray-400">
              <span>Learning Astro & Vercel</span>
              <span>30%</span>
            </div>
            <div class="w-full bg-gray-900 h-1.5 rounded-full overflow-hidden border border-border">
              <div class="bg-orange-500 h-full shadow-[0_0_10px_#fb923c]" style="width: 30%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-[15px] uppercase tracking-widest mb-1 text-gray-400">
              <span>Aquarium Management</span>
              <span>90%</span>
            </div>
            <div class="w-full bg-gray-900 h-1.5 rounded-full overflow-hidden border border-border">
              <div class="bg-blue-500 h-full opacity-60" style="width: 90%"></div>
            </div>
          </div>
        </div>
      </div>

      {
        SOCIALS.length > 0 && (
          <div class="mt-8 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-12 pb-6 border-b border-border">
          <h2 class="text-2xl font-semibold tracking-wide">Projekty</h2>
          <ul>
            {featuredPosts.slice(0, 3).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/recent-projects">
        All projects
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .blink {
    animation: blink-animation 1s steps(2, start) infinite;
  }
  @keyframes blink-animation {
    to { visibility: hidden; }
  }
  div[style^="width"] {
    transition: width 2s ease-out;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>