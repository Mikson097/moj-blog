---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import AquariumPhoto from "@/assets/images/akwa.jpg";
import { Image } from "astro:assets";

const posts = await getCollection("blog");
const allPosts = getSortedPosts(posts);
const sortedPosts = allPosts.filter(post => post.data.tags?.includes('akwarium'));
---

<Layout title={`Akwarium | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="pt-8 pb-6 border-b border-border">
      <h1 class="my-4 text-4xl font-bold sm:my-8 sm:text-5xl">
        Akwarium
      </h1>
      <p>
        Zdjęcia i informacje o moim akwarium.
      </p>
    </section>
    <section class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">Moje Akwarium</h2>
      <ul>
      <Image src={AquariumPhoto} alt="Moje akwarium — przód" class="w-full max-w-2xl mx-auto rounded-lg shadow-md" />
        {sortedPosts.map(data => (
          <Card {...data} />
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>